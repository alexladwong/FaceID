# main_layout.kv
## import local components
#:import tokens screens.tokens
#:import FadeTransition kivy.uix.screenmanager.FadeTransition
#:import FaceMatchBox screens.face_match.FaceMatchBox
#:import SettingsBox screens.setting.SettingsBox
#:import InitBox screens.init_screen.InitBox
#:import SecurityBox screens.security.SecurityBox
#:import AccessBox screens.access.AccessBox
#:import PeopleBox screens.people.PeopleBox
#:import NavigationMenu screens.navigation.NavigationMenu
#:import StatusPill screens.ui.StatusPill

## Main screen
MDScreen:
    md_bg_color: tokens.SURFACE

    MainScreenBox:  # main container
        orientation: "vertical"
        padding: 0, self.top_pad, 0, 0
        spacing: 0

        # --- top app bar ------------------------------------------------
        MDBoxLayout:
            orientation: "horizontal"
            size_hint_y: None
            height: dp(60)
            md_bg_color: tokens.PRIMARY
            padding: dp(6), 0, dp(8), 0
            spacing: dp(6)

            MDIconButton:
                icon: "menu"
                theme_icon_color: "Custom"
                icon_color: 1, 1, 1, 1
                opacity: 0 if app.is_wide else 1
                disabled: app.is_wide
                on_release: app.open_drawer()

            MDCard:
                size_hint: None, None
                size: dp(32), dp(32)
                radius: [dp(10)]
                elevation: 0
                md_bg_color: tokens.WHITE_18
                border_color: tokens.TRANSPARENT
                pos_hint: {"center_y": .5}
                MDIcon:
                    icon: "face-recognition"
                    theme_text_color: "Custom"
                    text_color: 1, 1, 1, 1
                    font_size: sp(18)
                    pos_hint: {"center_x": .5, "center_y": .5}

            MDBoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: dp(38)
                spacing: -dp(1)
                pos_hint: {"center_y": .5}

                MDLabel:
                    text: "Face AI"
                    font_size: sp(17)
                    bold: True
                    theme_text_color: "Custom"
                    text_color: 1, 1, 1, 1
                MDLabel:
                    text: "Offline face recognition"
                    font_size: sp(9)
                    theme_text_color: "Custom"
                    text_color: 1, 1, 1, .72

            Widget:

            StatusPill:
                text: "Engine running" if app.services_running else "Engine stopped"
                icon: "play-circle-outline"
                bg: tokens.SUCCESS_SOFT if app.services_running else tokens.WHITE_18
                fg: tokens.SUCCESS if app.services_running else "#FFFFFF"
                opacity: 1 if app.is_wide else 0
                disabled: not app.is_wide
                pos_hint: {"center_y": .5}

            MDIconButton:
                icon: "help-circle-outline"
                theme_icon_color: "Custom"
                icon_color: 1, 1, 1, 1
                on_release: app.show_help_dialog()

        # --- navigation panel + content ---------------------------------
        RelativeLayout:
            id: shell

            MDScreenManager:
                id: screen_manager
                size_hint: None, None
                x: app.nav_offset
                y: 0
                width: shell.width - app.nav_offset
                height: shell.height
                transition: FadeTransition(duration=.14)

                MDScreen:
                    name: "initScreen"
                    md_bg_color: tokens.SURFACE
                    on_enter: app.refresh_recent_outputs()
                    InitBox:
                        id: init_screen

                MDScreen:
                    name: "accessScr"
                    md_bg_color: tokens.SURFACE
                    on_enter: app.on_access_enter()
                    on_leave: app.on_access_leave()
                    AccessBox:
                        id: access_box

                MDScreen:
                    name: "peopleScr"
                    md_bg_color: tokens.SURFACE
                    on_enter: app.on_people_enter()
                    PeopleBox:
                        id: people_box

                MDScreen:
                    name: "faceFindScr"
                    md_bg_color: tokens.SURFACE
                    on_enter: app.on_face_matcher_entry()
                    FaceMatchBox:
                        id: face_match_scr

                MDScreen:
                    name: "securityScr"
                    md_bg_color: tokens.SURFACE
                    on_enter: app.on_security_enter()
                    on_leave: app.on_security_leave()
                    SecurityBox:
                        id: security_box

                MDScreen:
                    name: "settingsScr"
                    md_bg_color: tokens.SURFACE
                    on_enter: app.refresh_output_count()
                    SettingsBox:
                        id: settings_box

            MDCard:
                id: drawer_scrim
                size_hint: None, None
                x: 0
                y: 0
                width: shell.width
                height: shell.height
                radius: [0]
                elevation: 0
                md_bg_color: 0, 0, 0, .45
                border_color: tokens.TRANSPARENT
                opacity: 0
                disabled: True
                on_release: app.close_drawer()

            MDCard:
                id: nav_panel
                size_hint: None, None
                x: 0
                y: 0
                width: dp(232)
                height: shell.height
                radius: [0]
                elevation: 0
                md_bg_color: tokens.CARD
                border_color: tokens.LINE

                NavigationMenu:
                    id: nav_menu

# End
